# 이 파일을 복사해서 .env 라는 이름으로 저장한 뒤 값을 채우세요.
# .env 에는 비밀번호와 비밀 키가 들어가므로 절대 깃에 올리지 않습니다(.gitignore에 등록됨).

# Postgres 연결 주소
# Supabase 대시보드 위쪽의 [Connect] → Session pooler 주소를 복사하고,
# [YOUR-PASSWORD] 자리에 프로젝트를 만들 때 정한 DB 비밀번호를 넣습니다.
DATABASE_URL=postgresql://postgres.프로젝트ID:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# Supabase 사진 저장소(Storage)
# 둘 다 비워 두면 사진을 이 컴퓨터의 uploads 폴더에 저장합니다(연습 모드).
SUPABASE_URL=https://프로젝트ID.supabase.co
SUPABASE_SECRET_KEY=sb_secret_여기에_비밀_키

# 사진을 담을 저장 공간(버킷) 이름. 보통 바꿀 필요 없습니다.
STORAGE_BUCKET=photos

# A 검색에 쓸 AI 모델 (보통 바꿀 필요 없습니다)
EMBED_MODEL=siglip2-base

# B 단계: Claude API (둘 다 비워 두면 B 기능만 꺼지고 나머지는 그대로 동작합니다)
# ANTHROPIC_API_KEY: Claude 콘솔(platform.claude.com) → API Keys에서 만든 키 (sk-ant- 로 시작)
# CLAUDE_MODEL: 쓸 Claude 모델 이름 (Claude 문서의 모델 목록에서 고릅니다)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# 관리자 화면(/admin) 비밀번호. 8자 이상, 선생님과 운영 팀만 알게 하세요.
# 비워 두면 관리자 화면에 아무도 들어갈 수 없습니다.
ADMIN_PASSWORD=
